generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum QuestionMode {
  PICTURE_NAMING
  WORD_CLUE
  PHRASE
  CONVERSATION
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  name               String
  surname            String
  current_level      Int        @default(1)
  current_stage      Int        @default(1)
  current_streak     Int        @default(0)
  longest_streak     Int        @default(0)
  last_practice_date DateTime?  @db.Date
  is_pretest_passed  Boolean    @default(false)
  created            DateTime   @default(now())
  updatedDate        DateTime   @updatedAt
  accounts           Account[]
  authCodes          AuthCode[]
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  email             String?
  created           DateTime @default(now())
  updatedDate       DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthCode {
  codeHash  String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
}

model Question {
  id              String       @id @default(uuid()) @db.Uuid
  code            String       @unique
  level           Int
  stage           Int
  mode            QuestionMode
  sortOrder       Int
  promptText      String?
  targetText      String?
  acceptedAnswers String[]
  hintMeaning     String?
  hintSyllable    String?
  situation       String?
  keyWords        String[]
  exampleAnswers  String[]
  expectedTopic   String?
  imageUrl        String?
  imageKey        String?
  imageAlt        String?
  imagePrompt     String?
  isPretest       Boolean      @default(false)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([mode, level, stage, sortOrder])
  @@index([mode, level, stage, isActive])
  @@index([isPretest, isActive])
}
